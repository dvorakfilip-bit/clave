# Zkopíruj jako .env.local a doplň hodnoty ze Supabase (Project Settings → API).
# Bez nich aplikace běží s ukázkovým festivalem /demo-2027.

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Jen pro skripty (npm run seed) – nikdy necommitovat, nikomu neposílat.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa aplikace pro odkazy a QR kódy (na Vercelu se jinak použije produkční adresa projektu).
NEXT_PUBLIC_SITE_URL=

# Přihlášení odkazem do e-mailu – zapnout až s vlastním rozesíláním e-mailů (Resend).
NEXT_PUBLIC_MAGIC_LINK=false
